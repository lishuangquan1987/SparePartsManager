<Window x:Class="SparePartsManager.Views.SparePartEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SparePartEditViewModel, IsDesignTimeCreatable=True}"
        Title="编辑备件"
        Width="500" Height="530"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">
    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>
        <Style x:Key="DialogAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="+"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#155D27"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogSaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogCancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="16" BorderBrush="#E0E6ED" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- 名称 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" Style="{StaticResource DialogLabelStyle}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DialogTextBoxStyle}"/>

            <!-- 规格 + 按钮 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="规格：" Style="{StaticResource DialogLabelStyle}"/>
            <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Specifications}"
                          Style="{StaticResource DialogComboBoxStyle}"/>
                <Button Grid.Column="1"
                        Command="{Binding AddSpecCommand}"
                        Style="{StaticResource DialogAddButtonStyle}"/>
            </Grid>

            <!-- 型号 + 按钮 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="型号：" Style="{StaticResource DialogLabelStyle}"/>
            <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Models}"
                          Style="{StaticResource DialogComboBoxStyle}"/>
                <Button Grid.Column="1"
                        Command="{Binding AddModelCommand}"
                        Style="{StaticResource DialogAddButtonStyle}"/>
            </Grid>

            <!-- 厂家 + 按钮 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="厂家：" Style="{StaticResource DialogLabelStyle}"/>
            <Grid Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Manufacturers}"
                          Style="{StaticResource DialogComboBoxStyle}"/>
                <Button Grid.Column="1"
                        Command="{Binding AddManufacturerCommand}"
                        Style="{StaticResource DialogAddButtonStyle}"/>
            </Grid>

            <!-- 项目 + 按钮 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="项目：" Style="{StaticResource DialogLabelStyle}"/>
            <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Projects}"
                          Style="{StaticResource DialogComboBoxStyle}"/>
                <Button Grid.Column="1"
                        Command="{Binding AddProjectCommand}"
                        Style="{StaticResource DialogAddButtonStyle}"/>
            </Grid>

            <!-- 货位 -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="货位：" Style="{StaticResource DialogLabelStyle}"/>
            <Grid Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ShelfNo}" Height="28"/>
                <TextBlock Grid.Column="1" Text=" 架 " VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
                <TextBox Grid.Column="2" Text="{Binding LayerNo}" Height="28"/>
                <TextBlock Grid.Column="3" Text=" 层 " VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
                <TextBox Grid.Column="4" Text="{Binding PositionNo}" Height="28"/>
                <TextBlock Grid.Column="5" Text=" 位" VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
            </Grid>

            <!-- 备注 -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="备注：" Style="{StaticResource DialogLabelStyle}"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                     Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                     BorderBrush="#CCC" BorderThickness="1" Padding="6,4"/>

            <!-- 按钮区 -->
            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="取消" Style="{StaticResource DialogCancelButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="保存" Style="{StaticResource DialogSaveButtonStyle}"
                        Margin="12,0,0,0"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
