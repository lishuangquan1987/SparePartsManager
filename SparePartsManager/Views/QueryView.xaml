<UserControl x:Class="SparePartsManager.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QueryViewModel, IsDesignTimeCreatable=True}"
             Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="备件查询与管理" FontSize="18" FontWeight="Bold"
                   Foreground="#333" Margin="0,8,0,12"/>

        <!-- 可折叠筛选面板 -->
        <Border Grid.Row="1" Background="#F5F5FA" CornerRadius="4" Margin="0,0,0,8" Padding="0">
            <Expander Header="筛选条件" Background="Transparent" IsExpanded="True"
                      FontSize="13" FontWeight="SemiBold" Foreground="#444">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <Border Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: 快速搜索 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="搜索：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5"
                                     Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,4"/>

                            <!-- Row 1: 规格、型号 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="规格：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding SpecOptions}"
                                      Text="{Binding SearchSpecification, UpdateSourceTrigger=PropertyChanged}"
                                      Height="24" FontSize="12" Margin="0,4,8,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="型号：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" IsEditable="True"
                                      ItemsSource="{Binding ModelOptions}"
                                      Text="{Binding SearchModel, UpdateSourceTrigger=PropertyChanged}"
                                      Height="24" FontSize="12" Margin="0,4,8,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="厂家：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <ComboBox Grid.Row="1" Grid.Column="5" IsEditable="True"
                                      ItemsSource="{Binding ManufacturerOptions}"
                                      Text="{Binding SearchManufacturer, UpdateSourceTrigger=PropertyChanged}"
                                      Height="24" FontSize="12" Margin="0,4,0,4"/>

                            <!-- Row 2: 项目、状态 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="项目：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding ProjectOptions}"
                                      Text="{Binding SearchProjectName, UpdateSourceTrigger=PropertyChanged}"
                                      Height="24" FontSize="12" Margin="0,4,8,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="状态：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <ComboBox Grid.Row="2" Grid.Column="3"
                                      SelectedItem="{Binding SearchStatus}"
                                      ItemsSource="{Binding StatusFilterOptions}"
                                      Height="24" FontSize="12" Margin="0,4,8,4"/>

                            <!-- Row 3: 货架号、层号、位号（同一行紧凑排列） -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="货位：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,8,4">
                                <TextBlock Text="架" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Text="{Binding SearchShelfNo}" Width="50" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="层" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Text="{Binding SearchLayerNo}" Width="50" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="位" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Text="{Binding SearchPositionNo}" Width="50" Height="24"/>
                            </StackPanel>

                            <!-- Row 4: 入库日期从-到 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="入库日期：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,8,4">
                                <DatePicker SelectedDate="{Binding StockInDateFrom}" Width="100" Height="24" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" — " VerticalAlignment="Center" Margin="2,0" FontSize="12"/>
                                <DatePicker SelectedDate="{Binding StockInDateTo}" Width="100" Height="24" FontSize="12" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="4" Grid.Column="4" Text="入库人：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="5"
                                     Text="{Binding SearchStockInPerson, UpdateSourceTrigger=PropertyChanged}"
                                     Height="24" FontSize="12" Margin="0,4,0,4"/>

                            <!-- Row 5: 出库日期从-到、出库人 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="出库日期：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,8,4">
                                <DatePicker SelectedDate="{Binding StockOutDateFrom}" Width="100" Height="24" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" — " VerticalAlignment="Center" Margin="2,0" FontSize="12"/>
                                <DatePicker SelectedDate="{Binding StockOutDateTo}" Width="100" Height="24" FontSize="12" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="5" Grid.Column="4" Text="出库人：" VerticalAlignment="Center" Margin="4,4,2,4" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="5"
                                     Text="{Binding SearchStockOutPerson, UpdateSourceTrigger=PropertyChanged}"
                                     Height="24" FontSize="12" Margin="0,4,0,4"/>

                            <!-- Row 6: Search/Reset -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6"
                                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                                <Button Content="查询" Width="90" Height="30" FontSize="13"
                                        Background="#007ACC" Foreground="White" BorderThickness="0"
                                        Command="{Binding SearchCommand}" Margin="0,0,10,0"/>
                                <Button Content="重置" Width="80" Height="30" FontSize="13"
                                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                                        Command="{Binding ResetCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Expander>
        </Border>

        <!-- 工具栏：编辑 + 导出 -->
        <Border Grid.Row="2" Background="#F5F5FA" Padding="8,6" Margin="0,8,0,0" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="编辑选中" Height="32" FontSize="12" FontWeight="Bold"
                        Background="#FFB90F" Foreground="White" BorderThickness="0"
                        Command="{Binding EditCommand}" Padding="16,0"/>
                <Button Content="导出" Height="32" FontSize="12"
                        Background="#28A745" Foreground="White" BorderThickness="0"
                        Command="{Binding ExportCommand}" Margin="8,0,0,0" Padding="16,0"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  RowHeaderWidth="0" Background="White" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="80"/>
                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="厂家" Binding="{Binding Manufacturer}" Width="100"/>
                <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="80"/>
                <DataGridTextColumn Header="货架" Binding="{Binding ShelfNo}" Width="50"/>
                <DataGridTextColumn Header="层" Binding="{Binding LayerNo}" Width="40"/>
                <DataGridTextColumn Header="位" Binding="{Binding PositionNo}" Width="40"/>
                <DataGridTextColumn Header="入库日期" Binding="{Binding StockInDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="出库日期" Binding="{Binding StockOutDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="入库人" Binding="{Binding StockInPerson}" Width="70"/>
                <DataGridTextColumn Header="出库人" Binding="{Binding StockOutPerson}" Width="70"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="60"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="120"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter Property="Background" Value="#FFE6E6"/>
                            <Setter Property="Foreground" Value="#B41E1E"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- 底部：居中分页 -->
        <Border Grid.Row="4" Background="#F5F5FA" Padding="8,6" Margin="0,8,0,0" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="首页" Height="28" FontSize="11" Padding="6,0" Margin="0,0,2,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Command="{Binding FirstPageCommand}"/>
                <Button Content="上一页" Height="28" FontSize="11" Padding="6,0" Margin="0,0,2,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Command="{Binding PrevPageCommand}"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="8,0" Foreground="#555"
                           Text="{Binding PageInfo}"/>
                <Button Content="下一页" Height="28" FontSize="11" Padding="6,0" Margin="2,0,2,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Command="{Binding NextPageCommand}"/>
                <Button Content="末页" Height="28" FontSize="11" Padding="6,0" Margin="2,0,0,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Command="{Binding LastPageCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
