<UserControl x:Class="SparePartsManager.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel, IsDesignTimeCreatable=True}"
             Background="#F0F4F8">

    <UserControl.Resources>
        <vm:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="统计分析" FontSize="20" FontWeight="Bold"
                   Foreground="#1E3A5F" Margin="0,8,0,8"/>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                Padding="20,14" Margin="0,0,0,6"
                BorderBrush="#E0E6ED" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="从：" Style="{StaticResource LabelTextStyle}"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="130" Height="28" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="到：" Style="{StaticResource LabelTextStyle}"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="130" Height="28" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock Text="维度：" Style="{StaticResource LabelTextStyle}"/>
                <ComboBox SelectedItem="{Binding Dimension}" ItemsSource="{Binding DimensionOptions}"
                          Width="150" Height="28" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="查询" Width="90" Height="28" FontSize="12"
                        Style="{StaticResource FilterButtonStyle}"
                        Command="{Binding QueryCommand}"/>
            </StackPanel>
        </Border>

        <!-- 摘要文本 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                Padding="16,10" Margin="0,0,0,8"
                BorderBrush="#E0E6ED" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SummaryTextStyle}"/>
        </Border>

        <!-- 图表区域：笛卡尔图（柱状/折线）和饼图 -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="4"
                BorderBrush="#E0E6ED" BorderThickness="1">
            <Grid>
                <lvc:CartesianChart Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="None"
                                    TooltipPosition="Top"
                                    Visibility="{Binding IsPieChart, Converter={StaticResource InvertedBoolToVis}}"/>

                <lvc:PieChart Series="{Binding Series}"
                              TooltipPosition="Top"
                              Visibility="{Binding IsPieChart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
