<Window x:Class="SparePartsManager.Views.ImportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入备件"
        Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">
    <Window.Resources>
        <Style x:Key="DialogSaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0C4DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogCancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="16" BorderBrush="#E0E6ED" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="导入备件" FontSize="16" FontWeight="Bold"
                       Foreground="#1E3A5F" Margin="0,0,0,14"/>

            <!-- 文件选择区：上方显示已选择的 Excel 文件，可更改 -->
            <TextBlock Grid.Row="1" Text="选择要导入的 Excel 文件：" FontSize="12"
                       Foreground="#666" Margin="0,0,0,6"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathText" Grid.Column="0" Height="30" VerticalAlignment="Center"
                         IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1" Padding="6,2"
                         TextChanged="FilePathText_TextChanged"/>
                <Button Grid.Column="1" Content="选择文件…" Width="110" Height="30" Margin="8,0,0,0"
                        Background="#17A2B8" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BrowseButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="4" Text="导入选项（模板中填写的名称不存在时）：" FontSize="12"
                       Foreground="#666" Margin="0,0,0,6"/>

            <CheckBox Grid.Row="5" x:Name="AutoSpec" Content="规格不存在时自动创建" FontSize="13"
                      IsChecked="True" Margin="0,4,0,0"/>
            <CheckBox Grid.Row="6" x:Name="AutoModel" Content="型号不存在时自动创建" FontSize="13"
                      IsChecked="True" Margin="0,4,0,0"/>
            <CheckBox Grid.Row="7" x:Name="AutoManufacturer" Content="厂家不存在时自动创建" FontSize="13"
                      IsChecked="True" Margin="0,4,0,0"/>
            <CheckBox Grid.Row="8" x:Name="AutoProject" Content="项目不存在时自动创建" FontSize="13"
                      IsChecked="True" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="9" x:Name="HintText"
                       Text="提示：取消勾选后，若模板中的名称不存在将报错中止该行导入。"
                       FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,14,0,0"/>

            <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="取消" Style="{StaticResource DialogCancelButtonStyle}"
                        Click="CancelButton_Click"/>
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource DialogSaveButtonStyle}"
                        Margin="12,0,0,0" IsEnabled="False"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
