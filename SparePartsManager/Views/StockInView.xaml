<UserControl x:Class="SparePartsManager.Views.StockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
             Background="#F0F4F8">
    <UserControl.DataContext>
        <vm:StockInViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="备件入库登记" FontSize="20" FontWeight="Bold"
                       Foreground="#1E3A5F" Margin="0,8,0,24"/>

            <!-- 基本信息 -->
            <Border Background="White" CornerRadius="8" Padding="28"
                    BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="基本信息" FontSize="14" FontWeight="SemiBold"
                               Foreground="#007ACC" Margin="0,0,0,16"/>
                    <Border Height="1" Background="#E0E6ED" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <!-- 名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,16,0"/>

                        <!-- 规格 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="规格：" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Row="0" Grid.Column="3"
                                  Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Specifications}" IsEditable="True"
                                  Height="30" VerticalAlignment="Center"/>

                        <!-- 型号 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="型号：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,16,0"/>

                        <!-- 厂家 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="厂家：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                        <!-- 项目 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目：" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Projects}" IsEditable="True"
                                  Height="30" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <!-- 入库日期 -->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="入库日期：" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker Grid.Row="2" Grid.Column="3"
                                    SelectedDate="{Binding StockInDate}"
                                    Height="30" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 库存信息 -->
                    <TextBlock Text="库存信息" FontSize="14" FontWeight="SemiBold"
                               Foreground="#007ACC" Margin="0,24,0,16"/>
                    <Border Height="1" Background="#E0E6ED" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <!-- 货位 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="货位：" Style="{StaticResource FormLabelStyle}"/>
                        <DockPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                            <TextBox Text="{Binding ShelfNo}" Width="60" Height="28"/>
                            <TextBlock Text=" 架 " VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
                            <TextBox Text="{Binding LayerNo}" Width="60" Height="28"/>
                            <TextBlock Text=" 层 " VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
                            <TextBox Text="{Binding PositionNo}" Width="60" Height="28"/>
                            <TextBlock Text=" 位" VerticalAlignment="Center" Margin="4,0" Foreground="#666"/>
                        </DockPanel>

                        <!-- 入库人 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="入库人：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding StockInPerson}"
                                   VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A5F"/>

                        <!-- 数量 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="数量：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding Quantity}"
                                 Width="80" Height="28" HorizontalAlignment="Left"/>

                        <!-- 备注 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderBrush="#CCC" BorderThickness="1" Padding="6,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 按钮区 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="清空重填" Width="130" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearCommand}"/>
                <Button Content="保存入库" Width="150" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
