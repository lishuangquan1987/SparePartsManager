<Window x:Class="SparePartsManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
        xmlns:views="clr-namespace:SparePartsManager.Views"
        Title="备件库管理系统"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplate 资源 -->
        <DataTemplate DataType="{x:Type vm:StockInViewModel}">
            <views:StockInView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockOutViewModel}">
            <views:StockOutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueryViewModel}">
            <views:QueryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockAlertViewModel}">
            <views:StockAlertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManageViewModel}">
            <views:UserManageView/>
        </DataTemplate>

        <!-- 侧边栏按钮样式 -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CFD8E3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 侧边栏分组标题样式 -->
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8BA0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="16,16,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- ===== 顶部标题栏 ===== -->
            <Border DockPanel.Dock="Top" Height="48" Background="#007ACC">
                <DockPanel>
                    <TextBlock Text="备件库管理系统" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding UserInfo}" FontSize="12"
                               Foreground="#B3D9F2" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- ===== 状态栏（一半显示功能，一半闪烁告警） ===== -->
            <Border DockPanel.Dock="Bottom" Height="30" Background="#007ACC">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarningFlashing}" Value="True">
                                <Setter Property="Background" Value="#DC3545"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding WarningDetailText}" Foreground="#FFE0E0"
                               VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"
                               Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </Grid>
            </Border>

            <!-- ===== 左侧导航 ===== -->
            <Border DockPanel.Dock="Left" Width="220" Background="#1E3A5F">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="备件管理" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Content="  备件入库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="stockin"/>
                            <Button Content="  备件出库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="stockout"/>
                            <Button Content="  备件查询"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="query"/>
                            <Button Content="  统计分析"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="stats"/>

                            <TextBlock Text="系统管理" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Content="  用户管理"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="users"/>
                            <Button Content="  库存警告"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="alert"/>

                            <Separator Margin="16,16,16,8" Background="#2D5A7A"/>
                            <Button Content="  退出系统"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding ExitCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 右侧内容区 ===== -->
            <Border Background="#F0F4F8" Padding="4">
                <Border Background="White" CornerRadius="6" Padding="0">
                    <ContentControl Content="{Binding CurrentView}" Margin="0"/>
                </Border>
            </Border>
        </DockPanel>
    </Grid>
</Window>
