<Window
    x:Class="SparePartsManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SparePartsManager.Views"
    xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
    Title="备件库管理系统"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    Background="#F0F4F8"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  DataTemplate 资源  -->
        <DataTemplate DataType="{x:Type vm:StockInViewModel}">
            <views:StockInView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockOutViewModel}">
            <views:StockOutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueryViewModel}">
            <views:QueryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockAlertViewModel}">
            <views:StockAlertView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BasicDataViewModel}">
            <views:BasicDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManageViewModel}">
            <views:UserManageView />
        </DataTemplate>

        <!--  侧边栏按钮样式  -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CFD8E3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="42" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  侧边栏分组标题样式  -->
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8BA0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="16,16,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!--  ===== 顶部标题栏 =====  -->
        <Border Grid.Row="0" Background="#007ACC">
            <Grid>
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="备件库管理系统" />
                <TextBlock
                    Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#B3D9F2"
                    Text="{Binding UserInfo}" />
            </Grid>
        </Border>

        <!--  ===== 主区域：侧边栏 + 分割线 + 内容 =====  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="220"
                    MinWidth="150"
                    MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧导航  -->
            <Border Grid.Column="0" Background="#1E3A5F">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SidebarGroupHeaderStyle}" Text="备件管理" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="stockin"
                            Content="  备件入库"
                            Style="{StaticResource SidebarButtonStyle}" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="stockout"
                            Content="  备件出库"
                            Style="{StaticResource SidebarButtonStyle}" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="query"
                            Content="  备件查询"
                            Style="{StaticResource SidebarButtonStyle}" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="stats"
                            Content="  统计分析"
                            Style="{StaticResource SidebarButtonStyle}" />

                        <TextBlock Style="{StaticResource SidebarGroupHeaderStyle}" Text="系统管理" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="users"
                            Content="  用户管理"
                            Style="{StaticResource SidebarButtonStyle}" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="basicdata"
                            Content="  基础信息维护"
                            Style="{StaticResource SidebarButtonStyle}" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="alert"
                            Content="  库存警告"
                            Style="{StaticResource SidebarButtonStyle}" />

                        <Separator Margin="16,16,16,8" Background="#2D5A7A" />
                        <Button
                            Command="{Binding ExitCommand}"
                            Content="  退出系统"
                            Style="{StaticResource SidebarButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  可拖动分割线  -->
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="#D0D7E0"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="#D0D7E0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!--  右侧内容区  -->
            <Border
                Grid.Column="2"
                Padding="4"
                Background="#F0F4F8">
                <Border
                    Padding="0"
                    Background="White"
                    CornerRadius="6">
                    <ContentControl Margin="0" Content="{Binding CurrentView}" />
                </Border>
            </Border>
        </Grid>

        <!--  ===== 状态栏（一半显示功能，一半闪烁告警） =====  -->
        <Border Grid.Row="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#007ACC" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarningFlashing}" Value="True">
                            <Setter Property="Background" Value="#DC3545" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding StatusText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        MaxWidth="500"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#FFE0E0"
                        Text="{Binding WarningDetailText}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        Margin="0,0,12,0"
                        Padding="10,3"
                        VerticalAlignment="Center"
                        Background="#C9302C"
                        BorderThickness="0"
                        Command="{Binding DismissWarningCommand}"
                        Content="消除报警"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White"
                        Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
