<Window x:Class="SparePartsManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SparePartsManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=True}"
        Title="备件库管理系统 - 登录"
        Width="420" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid>
            <!-- 标题栏 -->
            <Border Height="32" Background="#007ACC" CornerRadius="8,8,0,0" VerticalAlignment="Top"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="备件库管理系统" Foreground="White" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="60,30">
                <TextBlock Text="用户登录" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333"/>

               

                <TextBlock Text="用户名" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" FontSize="14" Padding="8,4" Margin="0,0,0,12"/>

                <TextBlock Text="密码" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Padding="8,4" Height="32" Margin="0,0,0,20"/>

                <Button Content="登 录" Height="38" FontSize="15" FontWeight="Bold"
                        Background="#007ACC"  Foreground="White" BorderThickness="0"
                        IsDefault="True"
                        Click="LoginButton_Click"/>

                <Button Content="取 消" Height="38" FontSize="15" Margin="0,8,0,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="CancelButton_Click"/>
            </StackPanel>
            <!-- 错误提示 -->
            <TextBlock HorizontalAlignment="Center" Text="{Binding ErrorMessage}" Height="30" VerticalAlignment="Bottom"  Foreground="Red" FontSize="12"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                       TextWrapping="Wrap" Margin="0,0,0,15"  />
        </Grid>
    </Border>
</Window>
